{
  "manifest_version": 3,
  "name": "Goko Downloader",
  "short_name": "Goko",
  "version": "1.0.0",
  "description": "YouTube ve diğer sitelerden video, küçük resim ve görselleri en yüksek kalitede indirin.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Goko Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "css": [
        "content/youtube.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "key": ""
}
